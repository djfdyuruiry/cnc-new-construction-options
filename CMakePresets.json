{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "release",
            "displayName": "NCO Release build",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
                "CMAKE_FIND_FRAMEWORK": "LAST",
                "DSOUND": "OFF",
                "DDRAW": "OFF",
                "SDL2": "ON",
                "OPENAL": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg/overlays",
                "MAP_EDITOR_TD": "ON",
                "MAP_EDITOR_RA": "ON",
                "BUILD_TOOLS": "ON",
                "BUILD_TESTS": "ON"
            },
            "environment": {
                "VCPKG_ROOT": "${sourceDir}/.vcpkg"
            }
        },
        {
            "name": "remaster",
            "inherits": "release",
            "displayName": "NCO Remaster build",
            "cacheVariables": {
                "BUILD_REMASTER_TD": "ON",
                "BUILD_REMASTER_RA": "ON",
                "BUILD_NCO_TD": "OFF",
                "BUILD_NCO_RA": "OFF",
                "MAP_EDITOR_TD": "OFF",
                "MAP_EDITOR_RA": "OFF",
                "BUILD_TOOLS": "OFF",
                "VCPKG_TARGET_TRIPLET": "x86-windows-static-md"
            }
        },
        {
            "name": "remaster-debug",
            "inherits": "remaster",
            "displayName": "NCO Remaster debug build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "tiberian-dawn",
            "inherits": "release",
            "displayName": "NCO build (TD)",
            "cacheVariables": {
                "BUILD_NCO_RA": "OFF",
                "MAP_EDITOR_RA": "OFF"
            }
        },
        {
            "name": "red-alert",
            "inherits": "release",
            "displayName": "NCO build (RA)",
            "cacheVariables": {
                "BUILD_NCO_TD": "OFF",
                "MAP_EDITOR_TD": "OFF"
            }
        },
        {
            "name": "tiberian-dawn-remaster",
            "inherits": "remaster",
            "displayName": "NCO Remaster build (TD)",
            "cacheVariables": {
                "BUILD_REMASTER_RA": "OFF"
            }
        },
        {
            "name": "red-alert-remaster",
            "inherits": "remaster",
            "displayName": "NCO Remaster build (RA)",
            "cacheVariables": {
                "BUILD_REMASTER_TD": "OFF"
            }
        },
        {
            "name": "tiberian-dawn-remaster-debug",
            "inherits": "remaster-debug",
            "displayName": "NCO Remaster build (TD)",
            "cacheVariables": {
                "BUILD_REMASTER_RA": "OFF"
            }
        },
        {
            "name": "debug",
            "inherits": "release",
            "displayName": "NCO debug build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "red-alert-debug",
            "inherits": "red-alert",
            "displayName": "NCO debug build (RA)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "tiberian-dawn-debug",
            "inherits": "tiberian-dawn",
            "displayName": "NCO debug build (TD)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "configurePreset": "release",
            "displayName": "NCO Game Build",
            "description": "NCO Game Build",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "remaster",
            "configurePreset": "remaster",
            "displayName": "NCO Game Build",
            "description": "NCO Game Build",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "remaster-debug",
            "configurePreset": "remaster-debug",
            "displayName": "NCO Debug Build",
            "description": "NCO Debug Build",
            "configuration": "Debug"
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "displayName": "NCO Debug Build",
            "description": "NCO Debug Build",
            "configuration": "Debug"
        },
        {
            "name": "red-alert",
            "configurePreset": "red-alert",
            "displayName": "NCO Red Alert Build",
            "description": "NCO Red Alert Build",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "tiberian-dawn",
            "configurePreset": "tiberian-dawn",
            "displayName": "NCO Tiberian Dawn Build",
            "description": "NCO Tiberian Dawn Build",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "red-alert-debug",
            "configurePreset": "red-alert-debug",
            "displayName": "NCO Red Alert Debug Build",
            "description": "NCO Red Alert Debug Build",
            "configuration": "Debug"
        },
        {
            "name": "tiberian-dawn-debug",
            "configurePreset": "tiberian-dawn-debug",
            "displayName": "NCO Tiberian Dawn Debug Build",
            "description": "NCO Tiberian Dawn Debug Build",
            "configuration": "Debug"
        },
        {
            "name": "red-alert-remaster",
            "configurePreset": "red-alert-remaster",
            "displayName": "NCO Red Alert Build (remaster)",
            "description": "NCO Red Alert Build (remaster)",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "tiberian-dawn-remaster",
            "configurePreset": "tiberian-dawn-remaster",
            "displayName": "NCO Tiberian Dawn Build (remaster)",
            "description": "NCO Tiberian Dawn Build (remaster)",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "tiberian-dawn-remaster-debug",
            "configurePreset": "tiberian-dawn-remaster-debug",
            "displayName": "NCO Tiberian Dawn Build (remaster)",
            "description": "NCO Tiberian Dawn Build (remaster)",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "testing",
            "configurePreset": "release",
            "configuration": "RelWithDebInfo",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "release",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                },
                {
                    "type": "test",
                    "name": "testing"
                }
            ]
        },
        {
            "name": "remaster",
            "steps": [
                {
                    "type": "configure",
                    "name": "remaster"
                },
                {
                    "type": "build",
                    "name": "remaster"
                }
            ]
        },
        {
            "name": "remaster-debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "remaster-debug"
                },
                {
                    "type": "build",
                    "name": "remaster-debug"
                }
            ]
        },
        {
            "name": "debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
                    "type": "build",
                    "name": "debug"
                }
            ]
        },
        {
            "name": "tiberian-dawn-debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "tiberian-dawn-debug"
                },
                {
                    "type": "build",
                    "name": "tiberian-dawn-debug"
                }
            ]
        },
        {
            "name": "red-alert-debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "red-alert-debug"
                },
                {
                    "type": "build",
                    "name": "red-alert-debug"
                }
            ]
        },
        {
            "name": "tiberian-dawn-remaster-debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "tiberian-dawn-remaster-debug"
                },
                {
                    "type": "build",
                    "name": "tiberian-dawn-remaster-debug"
                }
            ]
        }
    ]
}
