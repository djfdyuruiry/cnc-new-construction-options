{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug TD",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "Build & Deploy TD",
      "program": "${env:HOME}/Games/cnc-tiberian-dawn/vanillatd-dev",
      "args": [
        "-CHEAT"
      ],
      "cwd": "${env:HOME}/Games/cnc-tiberian-dawn",
      "envFile": "${workspaceFolder}/.env",
      "environment": [
        {
          "name": "NCO_LOG_LEVEL",
          "value": "debug,LuaEngine=trace,Find_File_Data=off"
        }
      ]
    },
    {
      "name": "Debug RA",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "Build & Deploy RA",
      "program": "${env:HOME}/Games/cnc-red-alert/vanillara-dev",
      "cwd": "${env:HOME}/Games/cnc-red-alert",
      "envFile": "${workspaceFolder}/.env",
      "environment": [
        {
          "name": "NCO_LOG_LEVEL",
          "value": "debug,Find_File_Data=off"
        }
      ]
    },
    // requires 2.0.9 extension version for 'Lua Debug'
    {
      "arg": [],
      "name": "Debug Lua Unit Tests",
      "program": "${workspaceFolder}/tests/lua/scripts/tests/unit/init.lua",
      "request": "launch",
      "stopOnEntry": false,
      "type": "lua",
      "luaVersion": "lua54",
      "path": "${workspaceFolder}/common/lua/scripts/?.lua;${workspaceFolder}/common/lua/scripts/?/init.lua;${workspaceFolder}/tiberiandawn/lua/scripts/?.lua;${workspaceFolder}/tiberiandawn/lua/scripts/?/init.lua;${workspaceFolder}/tests/lua/scripts/?.lua;${workspaceFolder}/tests/lua/scripts/?/init.lua"
    },
    {
      "arg": [],
      "name": "Debug scg01ea.lua",
      "program": "${workspaceFolder}/tiberiandawn/lua/scripts/scg01ea.lua",
      "request": "launch",
      "stopOnEntry": false,
      "type": "lua",
      "luaVersion": "lua54",
      "path": "${workspaceFolder}/common/lua/scripts/?.lua;${workspaceFolder}/common/lua/scripts/?/init.lua;${workspaceFolder}/tiberiandawn/lua/scripts/?.lua;${workspaceFolder}/tiberiandawn/lua/scripts/?/init.lua;${workspaceFolder}/tests/lua/scripts/?.lua;${workspaceFolder}/tests/lua/scripts/?/init.lua"
    }
  ]
}
