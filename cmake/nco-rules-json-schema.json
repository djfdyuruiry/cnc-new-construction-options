{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "NCO metadata for game rules",
  "description": "Metadata for a section of a rules.ini file",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "section": {
      "type": "string",
      "description": "INI identifier for the section"
    },
    "ini_comment": {
      "type": "string",
      "description": "Description of the section to be displayed above it in the INI file"
    },
    "comment": {
      "type": "string",
      "description": "Description of the section as markdown"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the rule"
          },
          "type": {
            "type": "string",
            "enum": [
              "int",
              "bool",
              "float",
              "fixed",
              "converter"
            ],
            "description": "Type of the rule value"
          },
          "converter_type": {
            "type": "string",
            "description": "If type is 'converter', the game engine typename for the rule value"
          },
          "default": {
            "description": "Default value for the rule"
          },
          "comment": {
            "type": "string",
            "description": "Explanation of the rule"
          },
          "implemented": {
            "type": "boolean",
            "description": "Is behavior for this rule actually implemented yet?"
          }
        },
        "required": [
          "name",
          "type",
          "default"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "section",
    "ini_comment",
    "comment",
    "rules"
  ],
  "additionalProperties": false
}
