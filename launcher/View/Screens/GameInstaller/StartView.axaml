<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:vm="clr-namespace:CNC.NCO.Launcher.ViewModel.Screens.GameInstaller"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          x:Class="CNC.NCO.Launcher.View.Screens.GameInstaller.StartView"
                          x:TypeArguments="vm:StartViewModel"
                          x:DataType="vm:StartViewModel"
                          mc:Ignorable="d"
                          d:DesignWidth="1024"
                          d:DesignHeight="740">
  <Grid RowDefinitions="Auto,*,Auto,*,Auto" Margin="5">
    <TextBlock Classes="h1" Margin="0,10" Grid.Row="0">
      Welcome to the New Construction Options (NCO) Installer
    </TextBlock>

    <StackPanel Grid.Row="1"/>

    <StackPanel Grid.Row="2">
      <TextBlock Classes="p-large" Margin="0,10">
        This wizard will help you get both NCO and all required Command &amp; Conquer data installed, so you can play the games.
      </TextBlock>
      <TextBlock Classes="p-large" Margin="0,10,0,0">
        On the next screens you can choose the install path and which games/features you want to install.
      </TextBlock>
    </StackPanel>

    <StackPanel Grid.Row="3"/>

    <Button Classes="nco-button"
            Content="Get Started"
            Command="{Binding Next}"
            HorizontalAlignment="Right"
            Grid.Row="4"/>
  </Grid>
</rxui:ReactiveUserControl>
