<rxui:ReactiveUserControl x:Class="CNC.NCO.Launcher.View.Screens.GameInstaller.StartView"
                          x:TypeArguments="vm:StartViewModel"
                          x:DataType="vm:StartViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:vm="clr-namespace:CNC.NCO.Launcher.ViewModel.Screens.GameInstaller"
                          Background="{Binding BackgroundImage}"
                          mc:Ignorable="d"
                          d:DesignWidth="800"
                          d:DesignHeight="450">
  <StackPanel>
    <TextBlock TextWrapping="Wrap" Margin="0,10">
      Welcome to the New Construction Options (NCO) installer.
    </TextBlock>
    <TextBlock TextWrapping="Wrap" Margin="0,10">
      This wizard will help you get both NCO and all required Command &amp; Conquer data installed so you can play the games.
    </TextBlock>
    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
      On the next screen you can choose which games you want to install.
    </TextBlock>
    <Button Content="Get Started" Command="{Binding Begin}" Margin="0,15,0,0"/>
  </StackPanel>
</rxui:ReactiveUserControl>
