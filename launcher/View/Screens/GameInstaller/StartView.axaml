<rxui:ReactiveUserControl x:Class="CNC.NCO.Launcher.View.Screens.GameInstaller.StartView"
                          x:TypeArguments="vm:StartViewModel"
                          x:DataType="vm:StartViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:vm="clr-namespace:CNC.NCO.Launcher.ViewModel.Screens.GameInstaller"
                          Background="{Binding BackgroundImage}"
                          mc:Ignorable="d"
                          d:DesignWidth="800"
                          d:DesignHeight="450">
  <StackPanel>
    <Button Command="{Binding Install}" Content="Begin Installation"/>
  </StackPanel>
</rxui:ReactiveUserControl>
