<rxui:ReactiveUserControl x:Class="CNC.NCO.Launcher.View.Screens.GameInstaller.SelectInstallPathView"
                          x:TypeArguments="vm:SelectInstallPathViewModel"
                          x:DataType="vm:SelectInstallPathViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:vm="clr-namespace:CNC.NCO.Launcher.ViewModel.Screens.GameInstaller"
                          mc:Ignorable="d"
                          d:DesignWidth="800"
                          d:DesignHeight="600">
  <StackPanel>
    <Grid ColumnDefinitions="8*,2*">
      <TextBox Grid.Column="0" Text="{Binding Path=InstallPath, Mode=TwoWay}" />
      <Button Grid.Column="1" Command="{Binding Browse}" Margin="15,0">Browse</Button>
    </Grid>
    <Button Content="Install" Command="{Binding Next}" Margin="0,15"></Button>
  </StackPanel>
</rxui:ReactiveUserControl>
