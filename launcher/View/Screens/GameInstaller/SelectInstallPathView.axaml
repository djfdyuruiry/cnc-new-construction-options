<rxui:ReactiveUserControl x:Class="CNC.NCO.Launcher.View.Screens.GameInstaller.SelectInstallPathView"
                          x:TypeArguments="vm:SelectInstallPathViewModel"
                          x:DataType="vm:SelectInstallPathViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:vm="clr-namespace:CNC.NCO.Launcher.ViewModel.Screens.GameInstaller"
                          mc:Ignorable="d"
                          d:DesignWidth="1024"
                          d:DesignHeight="740">
  <Grid RowDefinitions="Auto,*,Auto,*,Auto" Margin="5">
    <TextBlock Classes="h1" Margin="0,10" Grid.Row="0">
      Select Install Directory
    </TextBlock>

    <StackPanel Grid.Row="1"/>

    <Grid ColumnDefinitions="*,Auto" Grid.Row="2">
      <TextBox Classes="p-large" Grid.Column="0" Text="{Binding Path=InstallPath, Mode=TwoWay}"/>
      <Button Classes="nco-button"
              Grid.Column="1"
              Command="{Binding Browse}"
              Margin="15,0">
        Browse
      </Button>
    </Grid>

    <StackPanel Grid.Row="3"/>

    <Button Classes="nco-button"
            HorizontalAlignment="Right"
            Content="Install"
            Command="{Binding Next}"
            Grid.Row="4"/>
  </Grid>
</rxui:ReactiveUserControl>
