<rxui:ReactiveUserControl x:Class="CNC.NCO.Launcher.View.Screens.GameInstaller.InstallGameView"
                          x:TypeArguments="vm:InstallGameViewModel"
                          x:DataType="vm:InstallGameViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
                          xmlns:vm="clr-namespace:CNC.NCO.Launcher.ViewModel.Screens.GameInstaller"
                          mc:Ignorable="d"
                          d:DesignWidth="1024"
                          d:DesignHeight="740">
  <Grid RowDefinitions="Auto,*,*,Auto" Margin="5">
    <TextBlock Classes="h1" Text="Installing New Construction Options" Grid.Row="0"/>

    <!-- Disc Images Section -->
    <StackPanel Margin="0,10,0,0" Grid.Row="1">
      <ItemsControl ItemsSource="{Binding DiscImages}" IsEnabled="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="5">
              <TextBlock Classes="p" Text="•"/>
              <TextBlock Classes="p"
                         Text="{Binding Source.DisplayNameOrName}"
                         Margin="0,0,5,0"/>
              <Image IsVisible="{Binding Installing}"
                     anim:ImageBehavior.AnimatedSource="avares://CNC.NCO.Launcher/img/install.gif"
                     Width="20"
                     Height="20"/>
              <Image IsVisible="{Binding Installed}"
                     Source="avares://CNC.NCO.Launcher/img/tick.png"
                     Width="20"
                     Height="20"/>
              <Image IsVisible="{Binding Errored}"
                     Source="avares://CNC.NCO.Launcher/img/error.png"
                     Width="20"
                     Height="20"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Margin="0,7">
        <TextBlock Classes="p" Text="•"/>
        <TextBlock Classes="p" Text="New Construction Options - Game Engine" Margin="0,0,5,0"/>
        <Image IsVisible="{Binding NcoInstalling}"
               anim:ImageBehavior.AnimatedSource="avares://CNC.NCO.Launcher/img/install.gif"
               anim:ImageBehavior.RepeatBehavior="0x"
               Width="20"
               Height="20"/>
        <Image IsVisible="{Binding NcoInstalled}"
               Source="avares://CNC.NCO.Launcher/img/tick.png"
               Width="20"
               Height="20"/>
        <Image IsVisible="{Binding NcoErrored}"
               Source="avares://CNC.NCO.Launcher/img/error.png"
               Width="20"
               Height="20"/>
      </StackPanel>
    </StackPanel>

    <!-- Install Log and Status -->
    <DockPanel LastChildFill="True" Margin="0,10,0,0" Grid.Row="2">
      <TextBlock Classes="h2" Margin="0, 0, 0, 5" DockPanel.Dock="Top">
        Install Log
      </TextBlock>
      <ScrollViewer x:Name="InstallLogViewer" AllowAutoHide="False">
        <SelectableTextBlock FontSize="16"
                             TextWrapping="Wrap"
                             Text="{Binding InstallLog}"
                             DockPanel.Dock="Bottom"/>
      </ScrollViewer>
    </DockPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="3">
      <Button Classes="nco-button"
              Content="Start"
              Command="{Binding Start}" 
              Margin="0,0,2,0"
              IsEnabled="{Binding InstallNotClicked}"/>
      <Button Classes="nco-button"
              Content="Finish"
              Command="{Binding Finish}"
              Margin="2,0,0,0"
              IsEnabled="{Binding InstallFinished}"/>
    </StackPanel>
  </Grid>
</rxui:ReactiveUserControl>
