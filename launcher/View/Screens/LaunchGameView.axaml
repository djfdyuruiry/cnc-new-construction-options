<rxui:ReactiveUserControl x:Class="CNC.NCO.Launcher.View.Screens.LaunchGameView"
                          x:TypeArguments="vm:LaunchGameViewModel"
                          x:DataType="vm:LaunchGameViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:vm="clr-namespace:CNC.NCO.Launcher.ViewModel.Screens"
                          mc:Ignorable="d"
                          d:DesignWidth="1024"
                          d:DesignHeight="740">
  <TextBlock Text="{Binding Greeting}"/>
</rxui:ReactiveUserControl>
