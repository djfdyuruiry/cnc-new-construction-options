<rxui:ReactiveWindow xmlns="https://github.com/avaloniaui"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:rxui="http://reactiveui.net"
                     xmlns:vm="clr-namespace:CNC.NCO.Launcher.ViewModel"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     x:Class="CNC.NCO.Launcher.MainWindow"
                     x:TypeArguments="vm:MainViewModel"
                     x:DataType="vm:MainViewModel"
                     Title="CNC: New Construction Options"
                     Width="1024"
                     Height="768"
                     WindowStartupLocation="CenterScreen"
                     mc:Ignorable="d"
                     d:DesignWidth="1024"
                     d:DesignHeight="768">
  <!-- This could replicate an old windows 9x installer for retro feel -->
  <Grid RowDefinitions="*,Auto">
    <rxui:RoutedViewHost HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Stretch"
                         Router="{Binding Router}"
                         Grid.Row="0" />

    <Border BorderBrush="White" BorderThickness="2" CornerRadius="2" Margin="10" Grid.Row="1">
      <StackPanel Orientation="Horizontal" Margin="5">
        <Button Classes="nco-button"
                IsEnabled="{Binding NcoInstalled}"
                Command="{Binding Play}"
                Content="Play"/>
        <Button Classes="nco-button"
                IsEnabled="{Binding InstallerEnabled}"
                Command="{Binding Install}"
                Content="Install"
                Margin="5,0,5,0"/>
        <Button Classes="nco-button"
                Command="{Binding Exit}"
                Content="Exit"/>
      </StackPanel>
    </Border>
  </Grid>
</rxui:ReactiveWindow>
