<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CNC.NCO.Launcher.App"
             RequestedThemeVariant="Default"> <!-- "Default" follows system theme variant -->
    <Application.Styles>
        <FluentTheme/>

        <Style Selector="TextBlock.h1">
          <Setter Property="FontWeight" Value="Bold"/>
          <Setter Property="FontSize" Value="34"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="TextBlock.h2">
          <Setter Property="FontWeight" Value="Bold"/>
          <Setter Property="FontSize" Value="22"/> 
          <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    
        <Style Selector="SelectableTextBlock.p-large">
          <Setter Property="FontSize" Value="22"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    
        <Style Selector="TextBlock.p-large">
          <Setter Property="FontSize" Value="22"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="TextBlock.p">
          <Setter Property="FontSize" Value="18"/>  
          <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        
        <Style Selector="CheckBox.header">
          <Setter Property="FontWeight" Value="Bold"/>
          <Setter Property="FontSize" Value="22"/>
        </Style>
        
        <Style Selector="CheckBox.node">
          <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style Selector="Button.nco-button">
          <Setter Property="FontSize" Value="22"/>  
        </Style>
    </Application.Styles>
</Application>
